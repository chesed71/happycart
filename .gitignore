# HappyCart 모노레포 루트 .gitignore
# Flutter 프로젝트 자체 ignore 는 happycart/.gitignore 가 담당.

# macOS
.DS_Store

# Supabase CLI 로컬 캐시
supabase/.temp/
supabase/.branches/

# 환경 변수
.env
.env.local
*.local

# IDE
.idea/
.vscode/

# OS
Thumbs.db

# Dart / Flutter (백업)
**/.dart_tool/
**/build/
**/.pub-cache/

# Logs
*.log

# 견적서 (PDF/HTML, 로컬 전용 — git 추적 제외)
docs/Quote/

# Node (로컬 도구 전용 — codex 런타임 심링크 포함)
node_modules

# 로컬 작업 산출물·스크립트 (git 추적 제외)
outputs/
scripts/

# superpowers 로컬 plan 문서 (spec 만 추적)
docs/superpowers/plans/

# Play 출시 진행상황 (Play Console developer/app ID·개인 이메일 포함 — 이 저장소는 public)
docs/play-store-출시-진행상황.md
